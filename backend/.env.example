APP_NAME=Ghana Education News
APP_ENV=development
DATABASE_URL=sqlite:///./data/ghanaed.db
LOG_LEVEL=INFO
INGESTION_ENABLED=true
INGESTION_INTERVAL_SECONDS=300
INGESTION_TIMEOUT_SECONDS=20
RELEVANCE_PUBLISH_THRESHOLD=0.6
RELEVANCE_REJECT_THRESHOLD=0.35
